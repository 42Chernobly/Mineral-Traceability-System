# Copy to .env and edit. Never commit the real .env.
PORT=3000
NODE_ENV=development

# PostgreSQL. Leave empty to run the zero-setup in-memory demo database.
# DATABASE_URL=postgres://user:password@localhost:5432/mineral_traceability
# DATABASE_SSL=false

# REQUIRED in production: random strings, 32+ chars (e.g. openssl rand -hex 32)
JWT_SECRET=
QR_SECRET=
JWT_EXPIRY=8h

# Public https URL of the deployed app (used inside QR codes). Optional locally.
BASE_URL=

# Load SIMULATED demo users/batches (default: true only when DATABASE_URL is empty)
SEED_DEMO=true
DEMO_PASSWORD=Demo@12345

# Map basemap. Default: CARTO light/dark (no key needed; free for non-commercial use with attribution).
# Do NOT use tile.openstreetmap.org for a deployed app: it blocks apps ("Access blocked", 403).
# To use another provider (e.g. MapTiler / Stadia Maps with your API key), set:
# TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# TILE_URL_DARK=https://api.maptiler.com/maps/streets-v2-dark/{z}/{x}/{y}.png?key=YOUR_KEY
# TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
# TILE_SUBDOMAINS=abcd

# Lets an admin simulate database tampering to demo detection. Keep false in real deployments.
ENABLE_TAMPER_DEMO=true

# Production first-run: creates this administrator when the database has no users (min 12 chars)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
